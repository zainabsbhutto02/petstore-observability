{
  "uid": "a3-load-balancing",
  "title": "Paws & Cart - A3 Load Balancing (per replica)",
  "description": "Assignment 3. HTTP (GET /products) and gRPC (ListProducts) through Envoy, per replica A/B/C. Prometheus scrapes every replica and Envoy directly every 5 s. Rates, shares and percentiles use a 1-minute window: rate(...[1m]) and histogram_quantile over rate(..._bucket[1m]). The 'share over selected range' bars use increase(...[$__range]) for the whole time range chosen at the top right.",
  "tags": ["assignment-3", "envoy", "load-balancing"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "graphTooltip": 1,
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {"id": 1, "type": "row", "title": "HTTP - GET /products through Envoy, per replica", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0}, "panels": []},

    {"id": 2, "type": "timeseries", "title": "HTTP request rate per replica (req/s, 1m window)",
     "description": "sum by (replica) (rate(petstore_http_request_duration_seconds_count{route!~\"/metrics|/health\"}[1m])). Replicas with no traffic are shown as 0 (up * 0).",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
     "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}},
       "overrides": [
         {"matcher": {"id": "byRegexp", "options": "^A.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
         {"matcher": {"id": "byRegexp", "options": "^B.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byRegexp", "options": "^C.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}]},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "legendFormat": "{{replica}}",
       "expr": "sum by (replica) (rate(petstore_http_request_duration_seconds_count{job=\"petstore-app\", route!~\"/metrics|/health\"}[1m])) or sum by (replica) (up{job=\"petstore-app\"}) * 0"}]},

    {"id": 3, "type": "timeseries", "title": "HTTP share of total traffic per replica (%, 1m window)",
     "description": "100 * replica rate / total rate. Dashed line = 33.3 % (equal round robin).",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"lineWidth": 2, "fillOpacity": 0, "thresholdsStyle": {"mode": "dashed"}},
         "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}, {"color": "red", "value": 33.3}]}},
       "overrides": [
         {"matcher": {"id": "byRegexp", "options": "^A.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
         {"matcher": {"id": "byRegexp", "options": "^B.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byRegexp", "options": "^C.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}]},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean"]}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "legendFormat": "{{replica}}",
       "expr": "100 * sum by (replica) (rate(petstore_http_request_duration_seconds_count{job=\"petstore-app\", route!~\"/metrics|/health\"}[1m])) / scalar(sum(rate(petstore_http_request_duration_seconds_count{job=\"petstore-app\", route!~\"/metrics|/health\"}[1m]))) or sum by (replica) (up{job=\"petstore-app\"}) * 0"}]},

    {"id": 4, "type": "bargauge", "title": "HTTP share over the selected time range (%)",
     "description": "100 * increase(count[$__range]) per replica / total. Set the time range to exactly one run to compare with 33 % (round robin) or 50/25/25 % (weighted).",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1,
         "color": {"mode": "fixed", "fixedColor": "blue"}},
       "overrides": [
         {"matcher": {"id": "byName", "options": "B"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byName", "options": "C"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}]},
     "options": {"orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "valueMode": "color", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "targets": [{"refId": "A", "legendFormat": "{{replica}}", "instant": true, "range": false,
       "expr": "100 * sum by (replica) (increase(petstore_http_request_duration_seconds_count{job=\"petstore-app\", route!~\"/metrics|/health\"}[$__range])) / scalar(sum(increase(petstore_http_request_duration_seconds_count{job=\"petstore-app\", route!~\"/metrics|/health\"}[$__range]))) or sum by (replica) (up{job=\"petstore-app\"}) * 0"}]},

    {"id": 5, "type": "timeseries", "title": "Active HTTP requests per replica (in flight)",
     "description": "petstore_http_requests_in_flight per replica (sampled every 5 s; /metrics and /health are not counted) and Envoy's upstream active requests for the whole HTTP cluster.",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 9},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0, "custom": {"lineWidth": 2, "fillOpacity": 10, "axisSoftMax": 5}},
       "overrides": [
         {"matcher": {"id": "byRegexp", "options": "^A.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
         {"matcher": {"id": "byRegexp", "options": "^B.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byRegexp", "options": "^C.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
         {"matcher": {"id": "byRegexp", "options": "^Envoy.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 4]}}]}]},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "legendFormat": "{{replica}}", "expr": "sum by (replica) (petstore_http_requests_in_flight{job=\"petstore-app\"})"},
       {"refId": "B", "legendFormat": "Envoy upstream active (all replicas)", "expr": "sum(envoy_cluster_upstream_rq_active{envoy_cluster_name=\"http_replicas\"})"}]},

    {"id": 6, "type": "timeseries", "title": "HTTP response time p50 / p95 per replica (server side, 1m window)",
     "description": "histogram_quantile(0.5 | 0.95, sum by (replica, le) (rate(petstore_http_request_duration_seconds_bucket[1m]))). Server-side time inside the replica; the client p95 (including Envoy and the network) is in the loadgen summary.",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 9},
     "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 0}},
       "overrides": [
         {"matcher": {"id": "byRegexp", "options": "^A.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
         {"matcher": {"id": "byRegexp", "options": "^B.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byRegexp", "options": "^C.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
         {"matcher": {"id": "byRegexp", "options": ".*p50$"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 4]}}]}]},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "legendFormat": "{{replica}} p95", "expr": "histogram_quantile(0.95, sum by (replica, le) (rate(petstore_http_request_duration_seconds_bucket{job=\"petstore-app\", route!~\"/metrics|/health\"}[1m])))"},
       {"refId": "B", "legendFormat": "{{replica}} p50", "expr": "histogram_quantile(0.50, sum by (replica, le) (rate(petstore_http_request_duration_seconds_bucket{job=\"petstore-app\", route!~\"/metrics|/health\"}[1m])))"}]},

    {"id": 7, "type": "timeseries", "title": "HTTP errors by status (req/s, 1m window)",
     "description": "Non-2xx responses counted by each replica, by status code, plus 4xx/5xx that Envoy returned to clients (includes errors Envoy generated itself, e.g. 503 when no replica was reachable).",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 9},
     "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}, "noValue": "0"},
       "overrides": [
         {"matcher": {"id": "byRegexp", "options": "^A.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
         {"matcher": {"id": "byRegexp", "options": "^B.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byRegexp", "options": "^C.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
         {"matcher": {"id": "byRegexp", "options": "^Envoy.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"]}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "legendFormat": "{{replica}} {{status_code}}", "expr": "sum by (replica, status_code) (rate(petstore_http_request_duration_seconds_count{job=\"petstore-app\", route!~\"/metrics|/health\", status_code!~\"2..\"}[1m]))"},
       {"refId": "B", "legendFormat": "Envoy to client {{envoy_response_code_class}}xx", "expr": "sum by (envoy_response_code_class) (rate(envoy_http_downstream_rq_xx{envoy_http_conn_manager_prefix=\"http_ingress\", envoy_response_code_class=~\"4|5\"}[1m]))"}]},

    {"id": 10, "type": "row", "title": "gRPC - PetStore/ListProducts through Envoy (HTTP/2, routed per call), per replica", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 17}, "panels": []},

    {"id": 11, "type": "timeseries", "title": "gRPC call rate per replica (calls/s, 1m window)",
     "description": "sum by (replica) (rate(grpc_server_handled_total[1m])). Replicas with no calls are shown as 0.",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 18},
     "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}},
       "overrides": [
         {"matcher": {"id": "byRegexp", "options": "^A.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
         {"matcher": {"id": "byRegexp", "options": "^B.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byRegexp", "options": "^C.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}]},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "legendFormat": "{{replica}}",
       "expr": "sum by (replica) (rate(grpc_server_handled_total{job=\"petstore-app\"}[1m])) or sum by (replica) (up{job=\"petstore-app\"}) * 0"}]},

    {"id": 12, "type": "timeseries", "title": "gRPC share of total calls per replica (%, 1m window)",
     "description": "100 * replica call rate / total call rate. Dashed line = 33.3 % (equal round robin).",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 18},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "custom": {"lineWidth": 2, "fillOpacity": 0, "thresholdsStyle": {"mode": "dashed"}},
         "thresholds": {"mode": "absolute", "steps": [{"color": "transparent", "value": null}, {"color": "red", "value": 33.3}]}},
       "overrides": [
         {"matcher": {"id": "byRegexp", "options": "^A.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
         {"matcher": {"id": "byRegexp", "options": "^B.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byRegexp", "options": "^C.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}]},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean"]}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "legendFormat": "{{replica}}",
       "expr": "100 * sum by (replica) (rate(grpc_server_handled_total{job=\"petstore-app\"}[1m])) / scalar(sum(rate(grpc_server_handled_total{job=\"petstore-app\"}[1m]))) or sum by (replica) (up{job=\"petstore-app\"}) * 0"}]},

    {"id": 13, "type": "bargauge", "title": "gRPC share over the selected time range (%)",
     "description": "100 * increase(grpc_server_handled_total[$__range]) per replica / total.",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 18},
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "decimals": 1,
         "color": {"mode": "fixed", "fixedColor": "blue"}},
       "overrides": [
         {"matcher": {"id": "byName", "options": "B"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byName", "options": "C"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]}]},
     "options": {"orientation": "horizontal", "displayMode": "basic", "showUnfilled": true, "valueMode": "color", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
     "targets": [{"refId": "A", "legendFormat": "{{replica}}", "instant": true, "range": false,
       "expr": "100 * sum by (replica) (increase(grpc_server_handled_total{job=\"petstore-app\"}[$__range])) / scalar(sum(increase(grpc_server_handled_total{job=\"petstore-app\"}[$__range]))) or sum by (replica) (up{job=\"petstore-app\"}) * 0"}]},

    {"id": 14, "type": "timeseries", "title": "Active gRPC calls per replica (in flight)",
     "description": "grpc_server_in_flight_requests per replica (sampled every 5 s) and Envoy's upstream active requests for the whole gRPC cluster.",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 0, "y": 26},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0, "custom": {"lineWidth": 2, "fillOpacity": 10, "axisSoftMax": 5}},
       "overrides": [
         {"matcher": {"id": "byRegexp", "options": "^A.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
         {"matcher": {"id": "byRegexp", "options": "^B.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byRegexp", "options": "^C.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
         {"matcher": {"id": "byRegexp", "options": "^Envoy.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "purple"}}, {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 4]}}]}]},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "legendFormat": "{{replica}}", "expr": "sum by (replica) (grpc_server_in_flight_requests{job=\"petstore-app\"}) or sum by (replica) (up{job=\"petstore-app\"}) * 0"},
       {"refId": "B", "legendFormat": "Envoy upstream active (all replicas)", "expr": "sum(envoy_cluster_upstream_rq_active{envoy_cluster_name=\"grpc_replicas\"})"}]},

    {"id": 15, "type": "timeseries", "title": "gRPC handling time p50 / p95 per replica (server side, 1m window)",
     "description": "histogram_quantile(0.5 | 0.95, sum by (replica, le) (rate(grpc_server_handling_seconds_bucket[1m]))).",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 8, "y": 26},
     "fieldConfig": {"defaults": {"unit": "s", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 0}},
       "overrides": [
         {"matcher": {"id": "byRegexp", "options": "^A.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
         {"matcher": {"id": "byRegexp", "options": "^B.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byRegexp", "options": "^C.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
         {"matcher": {"id": "byRegexp", "options": ".*p50$"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 4]}}]}]},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"]}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "legendFormat": "{{replica}} p95", "expr": "histogram_quantile(0.95, sum by (replica, le) (rate(grpc_server_handling_seconds_bucket{job=\"petstore-app\"}[1m])))"},
       {"refId": "B", "legendFormat": "{{replica}} p50", "expr": "histogram_quantile(0.50, sum by (replica, le) (rate(grpc_server_handling_seconds_bucket{job=\"petstore-app\"}[1m])))"}]},

    {"id": 16, "type": "timeseries", "title": "gRPC errors by status code (calls/s, 1m window)",
     "description": "Calls that each replica finished with a non-OK gRPC status, by code, plus calls that failed in Envoy before reaching a replica (Envoy's 5xx on the gRPC cluster; the client sees them as UNAVAILABLE, e.g. while a replica is stopped).",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 8, "x": 16, "y": 26},
     "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}, "noValue": "0"},
       "overrides": [
         {"matcher": {"id": "byRegexp", "options": "^A.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "blue"}}]},
         {"matcher": {"id": "byRegexp", "options": "^B.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "orange"}}]},
         {"matcher": {"id": "byRegexp", "options": "^C.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "green"}}]},
         {"matcher": {"id": "byRegexp", "options": "^Envoy.*"}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}]},
     "options": {"legend": {"displayMode": "table", "placement": "bottom", "calcs": ["sum", "max"]}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "legendFormat": "{{replica}} {{grpc_code}}", "expr": "sum by (replica, grpc_code) (rate(grpc_server_handled_total{job=\"petstore-app\", grpc_code!=\"OK\"}[1m]))"},
       {"refId": "B", "legendFormat": "Envoy to client (failed before a replica)", "expr": "sum(rate(envoy_cluster_upstream_rq_xx{envoy_cluster_name=\"grpc_replicas\", envoy_response_code_class=\"5\"}[1m]))"}]},

    {"id": 20, "type": "row", "title": "Envoy and scrape targets", "collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 34}, "panels": []},

    {"id": 21, "type": "timeseries", "title": "Envoy upstream request rate per cluster (req/s, 1m window)",
     "description": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total[1m])). Should match the sum of the per-replica rates above.",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 6, "x": 0, "y": 35},
     "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [{"refId": "A", "legendFormat": "{{envoy_cluster_name}}", "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total[1m]))"}]},

    {"id": 22, "type": "timeseries", "title": "Envoy endpoints: healthy / total per cluster",
     "description": "envoy_cluster_membership_healthy and envoy_cluster_membership_total. Drops when a replica fails its health checks.",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 6, "x": 6, "y": 35},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0, "custom": {"lineWidth": 2, "fillOpacity": 0}}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "legendFormat": "{{envoy_cluster_name}} healthy", "expr": "sum by (envoy_cluster_name) (envoy_cluster_membership_healthy)"},
       {"refId": "B", "legendFormat": "{{envoy_cluster_name}} total", "expr": "sum by (envoy_cluster_name) (envoy_cluster_membership_total)"}]},

    {"id": 23, "type": "timeseries", "title": "Envoy failures per cluster (per s, 1m window)",
     "description": "Connection failures, requests with no healthy host, upstream timeouts and upstream 5xx, per cluster.",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 6, "x": 12, "y": 35},
     "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"lineWidth": 2, "fillOpacity": 10}, "noValue": "0"}, "overrides": []},
     "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
     "targets": [
       {"refId": "A", "legendFormat": "{{envoy_cluster_name}} connect fail", "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_cx_connect_fail[1m])) > 0"},
       {"refId": "B", "legendFormat": "{{envoy_cluster_name}} no healthy host", "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_cx_none_healthy[1m])) > 0"},
       {"refId": "C", "legendFormat": "{{envoy_cluster_name}} timeout", "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_timeout[1m])) > 0"},
       {"refId": "D", "legendFormat": "{{envoy_cluster_name}} upstream 5xx", "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_xx{envoy_response_code_class=\"5\"}[1m])) > 0"}]},

    {"id": 24, "type": "timeseries", "title": "Prometheus scrape status (1 = up)",
     "description": "up for each replica (scraped directly, not through Envoy) and for Envoy's admin endpoint.",
     "datasource": {"type": "prometheus", "uid": "Prometheus"},
     "gridPos": {"h": 8, "w": 6, "x": 18, "y": 35},
     "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1, "decimals": 0, "custom": {"lineWidth": 2, "fillOpacity": 0}},
       "overrides": [
